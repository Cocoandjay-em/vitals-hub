# Vitals HUD backend configuration.
# Copy to server/.env and fill in. Every value can also be set at runtime
# from the app's Settings panel (stored in the SQLite database).

# API key for an OpenAI-compatible vision model (required for AI extraction).
# Works with OpenAI, Moonshot/Kimi, OpenRouter, Ollama, LM Studio, ...
AI_API_KEY=

# OpenAI-compatible base URL.
#   OpenAI:          https://api.openai.com/v1
#   Moonshot/Kimi:   https://api.moonshot.ai/v1   (or https://api.moonshot.cn/v1)
#   Ollama (local):  http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Vision-capable model id, e.g. gpt-5.6-luna (cheap), gpt-5.6-terra (balanced),
# gpt-4o-mini, moonshot-v1-8k-vision-preview, llava (local), ...
AI_MODEL=gpt-5.6-luna

# Server port (the Vite dev proxy targets 3101).
PORT=3101
